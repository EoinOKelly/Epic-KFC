{
  "name": "epic-messaging-blockchain",
  "version": "1.0.0",
  "description": "Merkle-root message integrity anchoring on Ethereum Sepolia",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.src.json",
    "compile": "hardhat compile",
    "test": "npm run build && hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "e2e": "npm run build && node scripts/e2e-with-backend.js",
    "serve:fidelity": "npx --yes serve fidelity-ui -p 5173"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17",
    "typescript": "^5.7.3"
  }
}
